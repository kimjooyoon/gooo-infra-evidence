package infraenvelopev2
namespace infraenvelopev2

entity ReleasedEnvelopeInput id "infra://released-domain-envelope-v2/released-envelope-input"
entity CoreReleaseReceipt id "infra://released-domain-envelope-v2/core-release"
entity InterchangeSpecReleaseReceipt id "infra://released-domain-envelope-v2/interchange-spec-release"
entity InfraReleaseReceipt id "infra://released-domain-envelope-v2/infra-release"
entity MetaActivityReceiptSet id "infra://released-domain-envelope-v2/meta-activities"
entity InfraDependencySource id "infra://released-domain-envelope-v2/infra-dependencies"
entity ProductProjection id "infra://released-domain-envelope-v2/product-projection"
entity EightFileEnvelope id "infra://released-domain-envelope-v2/eight-file-envelope"
entity ReadOnlyConformance id "infra://released-domain-envelope-v2/read-only-conformance"
entity UnknownCausalityReportSet id "infra://released-domain-envelope-v2/unknown-causality"
entity DeterministicReplayReceipt id "infra://released-domain-envelope-v2/deterministic-replay"
entity RefutedCounterexampleReports id "infra://released-domain-envelope-v2/refuted-counterexamples"
entity AuthorityBoundaryReceipt id "infra://released-domain-envelope-v2/authority-boundary"

activity ObserveCurrentCoreRelease(ReleasedEnvelopeInput) -> CoreReleaseReceipt
activity ObserveInterchangeSpecRelease(CoreReleaseReceipt) -> InterchangeSpecReleaseReceipt
activity ObserveInfraSemanticPlanRelease(CoreReleaseReceipt) -> InfraReleaseReceipt
activity BindTwelveMetaActivities(CoreReleaseReceipt, InterchangeSpecReleaseReceipt, InfraReleaseReceipt) -> MetaActivityReceiptSet
activity ObserveEightInfraDependencies(InfraReleaseReceipt, MetaActivityReceiptSet) -> InfraDependencySource
activity ProjectInfraEnvelope(MetaActivityReceiptSet, InfraDependencySource) -> ProductProjection
activity PublishEightFileInfraEnvelope(ProductProjection) -> EightFileEnvelope
activity ConformInfraEnvelopeReadOnly(EightFileEnvelope) -> ReadOnlyConformance
activity PreserveUnknownCausality(ReadOnlyConformance) -> UnknownCausalityReportSet
activity VerifyEnvelopeReplay(EightFileEnvelope) -> DeterministicReplayReceipt
activity RefuteMalformedCoreReports(ReadOnlyConformance) -> RefutedCounterexampleReports
activity PreserveInfraAuthorityBoundary(UnknownCausalityReportSet, DeterministicReplayReceipt, RefutedCounterexampleReports) -> AuthorityBoundaryReceipt
