package opentofureceipttransformationv1
namespace opentofureceipttransformationv1

entity OpenTofuReceiptConsumer id "infra://opentofu-receipt-transformation-v1/consumer"
entity ReleasedTransformationCore id "infra://opentofu-receipt-transformation-v1/released-transformation-core"
entity TransformationActivityAuthority id "infra://opentofu-receipt-transformation-v1/transformation-activity-authority"
entity OpenTofuReceiptPattern id "infra://opentofu-receipt-transformation-v1/receipt-pattern"
entity OpenTofuReceiptBaseline id "infra://opentofu-receipt-transformation-v1/receipt-baseline"
entity OpenTofuReceiptCandidate id "infra://opentofu-receipt-transformation-v1/receipt-candidate"
entity IsolatedOpenTofuReceipt id "infra://opentofu-receipt-transformation-v1/isolated-receipt"
entity OpenTofuReceiptBeforeAfter id "infra://opentofu-receipt-transformation-v1/before-after"
entity ExactOpenTofuReceiptEffect id "infra://opentofu-receipt-transformation-v1/exact-effect"
entity OpenTofuReceiptDenominator id "infra://opentofu-receipt-transformation-v1/denominator"
entity OpenTofuReceiptReplay id "infra://opentofu-receipt-transformation-v1/replay"
entity OpenTofuReceiptUnknownTrace id "infra://opentofu-receipt-transformation-v1/unknown-trace"
entity OpenTofuReceiptCounterexample id "infra://opentofu-receipt-transformation-v1/counterexample"

activity ObserveReleasedTransformationCore(OpenTofuReceiptConsumer) -> ReleasedTransformationCore
activity BindTransformationActivities(ReleasedTransformationCore) -> TransformationActivityAuthority
activity ObserveOpenTofuReceiptPattern(TransformationActivityAuthority) -> OpenTofuReceiptPattern
activity PinOpenTofuReceiptBaseline(OpenTofuReceiptPattern) -> OpenTofuReceiptBaseline
activity SelectMetaBoundOpenTofuReceiptCandidate(TransformationActivityAuthority, OpenTofuReceiptPattern) -> OpenTofuReceiptCandidate
activity ApplyCandidateToIsolatedOpenTofuReceipt(OpenTofuReceiptCandidate, OpenTofuReceiptBaseline) -> IsolatedOpenTofuReceipt
activity EvaluateOpenTofuReceiptBeforeAfter(OpenTofuReceiptBaseline, IsolatedOpenTofuReceipt) -> OpenTofuReceiptBeforeAfter
activity PublishExactOpenTofuReceiptEffect(OpenTofuReceiptBeforeAfter) -> ExactOpenTofuReceiptEffect
activity PreserveOpenTofuReceiptDenominator(TransformationActivityAuthority, OpenTofuReceiptBaseline, IsolatedOpenTofuReceipt) -> OpenTofuReceiptDenominator
activity VerifyOpenTofuReceiptTransformationReplay(ExactOpenTofuReceiptEffect, OpenTofuReceiptDenominator) -> OpenTofuReceiptReplay
activity PreserveOpenTofuReceiptUnknown(TransformationActivityAuthority) -> OpenTofuReceiptUnknownTrace
activity RefuteOpenTofuReceiptCounterexample(TransformationActivityAuthority) -> OpenTofuReceiptCounterexample
