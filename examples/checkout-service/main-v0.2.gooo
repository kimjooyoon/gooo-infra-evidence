package checkoutinfra
namespace checkoutinfra

entity GoooRelease id "gooo://release/v0.2.0-dev"
entity InfraAuthority id "checkout://infra/entity/authority-v2"
entity InfraActivityGraph id "checkout://infra/entity/activity-graph-v2"
entity TerraformDeclaration id "checkout://infra/entity/terraform-declaration-v2"
entity TerraformPlan id "checkout://infra/entity/terraform-plan-v2"
entity TerraformState id "checkout://infra/entity/terraform-state-v2"
entity OpenAPIContract id "checkout://infra/entity/openapi-contract-v2"
entity ServiceHandlerSymbol id "checkout://infra/entity/service-handler-symbol-v2"
entity ServiceArtifactProvenance id "checkout://infra/entity/service-artifact-provenance-v2"
entity DeploymentOutput id "checkout://infra/entity/deployment-output-v2"
entity RuntimeObservationSet id "checkout://infra/entity/runtime-observation-set-v2"
entity ReadOnlyObservation id "checkout://infra/entity/read-only-observation-v2"
entity EvidenceDecision id "checkout://infra/entity/evidence-decision-v2"

activity ObserveReleasedGoooIdentity(GoooRelease) -> EvidenceDecision
activity DeclareInfraAuthority(InfraAuthority) -> EvidenceDecision
activity BindInfraActivities(InfraActivityGraph) -> EvidenceDecision
activity ObserveTerraformDeclaration(TerraformDeclaration) -> EvidenceDecision
activity BindTerraformPlan(TerraformPlan) -> EvidenceDecision
activity BindTerraformState(TerraformState) -> EvidenceDecision
activity ObserveOpenAPIContract(OpenAPIContract) -> EvidenceDecision
activity BindServiceHandlerSymbol(ServiceHandlerSymbol) -> EvidenceDecision
activity BindServiceArtifactProvenance(ServiceArtifactProvenance) -> EvidenceDecision
activity BindDeploymentOutput(DeploymentOutput) -> EvidenceDecision
activity ObserveRuntimeDrift(RuntimeObservationSet) -> EvidenceDecision
activity ObserveReadOnlyEffect(ReadOnlyObservation) -> EvidenceDecision
